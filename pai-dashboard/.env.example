# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# GoHighLevel API Configuration
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_API_URL=https://rest.gohighlevel.com/v1

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pai_dashboard
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (for caching and real-time features)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication & Security
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32
JWT_SECRET=your_jwt_secret_here

# API Keys & External Services
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model to use for PAI chat (default: claude-sonnet-4-20250514)
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-3-5-sonnet-20241022
PAI_MODEL=claude-sonnet-4-20250514

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=ws://localhost:8888
WS_PORT=8888

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_REAL_TIME=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Monitoring & Logging
SENTRY_DSN=
LOG_LEVEL=info

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Development
NEXT_TELEMETRY_DISABLED=1
